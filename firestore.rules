rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
    
    // AUTH
    
    match /accounts/{document=**} {
    	allow read: if true;
      
      match /{docId} {
          allow read: if true;
          allow create: if true 
          && incomingData().email != null
          && incomingData().phoneNumber != null
          && incomingData().firstName != null
          && incomingData().lastName != null;
        allow update: if isAuthUid(docId);
      }
    }
    
    match /companies/{document=**} {
    	allow read: if isAuthenticated();
      
      match /{docId} {
        allow create: if isAuthUid(docId) 
          && incomingData().name != null
          && incomingData().email != null
          && incomingData().phoneNumber != null;
        allow update: if (isCompanyId(docId) 
        	&& (isAuthUid(docId) || isOwner()));
      }
    }
    
    
    // ADMINSTRATION
    
    match /admins/{document=**} {
    	allow read: if isAuthenticated();
      
      match /{docId} {
        allow create: if (isCompanyId(incomingData().company.docId) 
        	&& (isOwner() || (isAdmin())))
          && incomingData().company != null
          && incomingData().email != null
          && incomingData().phoneNumber != null
          && incomingData().firstName != null
          && incomingData().lastName != null;
        allow update: if true;
        allow delete: if isCompanyId(existingData().company.docId)
        	&& (isOwner() || (isAdmin() && hasRole('canManageAdmins')));
      }
    }  
    
    match /departments/{document=**} {
    	allow read: if isAuthenticated();
      
      match /{docId} {
        allow create: if (isCompanyId(incomingData().company.docId) 
        	&& (isOwner() || (isAdmin() )))
          && incomingData().company != null
          && incomingData().name != null
        allow update, delete: if isCompanyId(existingData().company.docId)
        	&& (isOwner() || (isAdmin()));
      }
    }
    
    // UTILITY FUNCTIONS
    function isAuthenticated() {
      return request.auth.uid != null;
    }

    function isAuthUid(uid) {
      return request.auth.uid == uid;
    }
    
    function isAdmin() {
      return request.auth.token.isAdmin;
    }
    
    function isOwner() {
      return request.auth.token.isOwner;
    }
    
    function isCompanyId(companyId) {
      return request.auth.token.companyId == companyId;
    }
    
    
    function hasRole(role) {
    return role in request.auth.token.roles;
     }


    // [READ] Data that exists on the Firestore document
    function existingData() {
      return resource.data;
    }

    // [WRITE] Data that is sent to a Firestore document
    function incomingData() {
      return request.resource.data;
    }
  }
}