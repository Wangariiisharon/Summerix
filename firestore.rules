rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    match /clients/{document=**} {
    	allow read: if true;
      
      match /{docId} {
        allow create: if isAuthUid(docId) 
          && incomingData().email != null
          && incomingData().phoneNumber != null
          && incomingData().firstName != null
          && incomingData().lastName != null;
        allow update: if isAuthUid(docId) || isOwner(existingData().company.docId)
        	|| (isAdmin(existingData().company.docId) 
          	&& hasRole('canManageClients'));
      }
    }
    
    match /companies/{document=**} {
    	allow read: if isAuthenticated();
      
      match /{docId} {
        allow create: if isAuthUid(docId) 
          && incomingData().name != null
          && incomingData().email != null
          && incomingData().phoneNumber != null;
        allow update: if isAuthUid(docId) || isOwner(existingData().company.docId);
      }
    }
    
    match /admins/{document=**} {
    	allow read: if isAuthenticated();
      
      match /{docId} {
        allow create: if (isOwner(existingData().company.docId) 
        	|| (isAdmin() && hasRole('canManageAdmins')))
          && incomingData().email != null
          && incomingData().phoneNumber != null
          && incomingData().firstName != null
          && incomingData().lastName != null;
        allow update: if isAuthUid(docId) || isOwner(existingData().company.docId)
        	|| (isAdmin(existingData().company.docId) 
          	&& hasRole('canManageAdmins'));
      }
    }
    
    match /vehicles/{document=**} {
    	allow read: if isAuthenticated();
      
      match /{docId} {
        allow create: if isAuthenticated() 
          && incomingData().company != null
          && incomingData().regNumber != null
          && incomingData().name != null
          && incomingData().make != null
          && incomingData().model != null
          && incomingData().status != null;
        allow update: if isOwner(existingData().company.docId)
        	|| (isAdmin(existingData().company.docId) 
          	&& hasRole('canManageVehicles'));
      }
    }
    
    match /trips/{document=**} {
    	allow read: if isAuthenticated();
      
      match /{docId} {
        allow create: if isAuthenticated() 
          && incomingData().company != null
          && incomingData().client != null
          && incomingData().driver != null;
        allow update: if isOwner(existingData().company.docId)
        	|| (isAdmin(existingData().company.docId) 
          	&& hasRole('canManageTrips'));
      }
    }
    
    
    // UTILITY FUNCTIONS
    function isAuthenticated() {
      return request.auth.uid != null;
    }

    function isAuthUid(uid) {
      return request.auth.uid == uid;
    }
    
    function isCompanyId(companyId) {
      return request.auth.token.companyId == companyId;
    }
    
    function isAdmin(companyId) {
      return request.auth.token.isAdmin && isCompanyId(companyId);
    }
    
    function isOwner(companyId) {
      return request.auth.token.isOwner && isCompanyId(companyId);
    }
    
    function hasRole(role) {
      return request.auth.token.roles.includes(role);
    }

    // [READ] Data that exists on the Firestore document
    function existingData() {
      return resource.data;
    }

    // [WRITE] Data that is sent to a Firestore document
    function incomingData() {
      return request.resource.data;
    }
  }
}
