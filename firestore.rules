rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    match /admins/{document=**} {
    	allow read: if isAuthenticated();
      
      match /{docId} {
        allow create: if (isOwner() || (isAdmin() && hasRole('canManageAdmins')))
          && incomingData().email != null
          && incomingData().phoneNumber != null
          && incomingData().firstName != null
          && incomingData().lastName != null;
        allow update: if isAuthUid(docId) || isOwner()
        	|| (isAdmin() && hasRole('canManageAdmins'));
      }
    }
    
    match /clients/{document=**} {
    	allow read: if true;
      
      match /{docId} {
        allow create: if isAuthUid(docId) 
          && incomingData().email != null
          && incomingData().phoneNumber != null
          && incomingData().firstName != null
          && incomingData().lastName != null;
        allow update: if isAuthUid(docId) || isOwner()
        	|| (isAdmin() && hasRole('canManageClients'));
      }
    }
    
    
    // UTILITY FUNCTIONS
    function isAuthenticated() {
      return request.auth.uid != null;
    }

    function isAuthUid(uid) {
      return request.auth.uid == uid;
    }
    
    function isAdmin() {
      return request.auth.token.isAdmin;
    }
    
    function isHost() {
      return request.auth.token.isHost;
    }
    
    function isOwner() {
      return request.auth.token.isOwner;
    }
    
    function hasRole(role) {
      return request.auth.token.roles.includes(role);
    }

    // [READ] Data that exists on the Firestore document
    function existingData() {
      return resource.data;
    }

    // [WRITE] Data that is sent to a Firestore document
    function incomingData() {
      return request.resource.data;
    }
  }
}