{
  "env": {
    "browser": true,
    "node": true,
    "es6": true
  },
  "globals": {
    "JSX": "readonly"
  },
  "extends": [
    "next",
    "next/core-web-vitals",
    // "plugin:react/all",
    "eslint:recommended",
    "plugin:import/errors",
    "plugin:import/warnings",
    "plugin:react/recommended",
    "plugin:prettier/recommended"
  ],
  "plugins": ["prettier"],
  "rules": {
    "indent": 0,
    "quotes": ["error", "single"],
    "semi": ["error", "always"],
    "prettier/prettier": "error",
    "no-use-before-define": "error",
    "react/react-in-jsx-scope": 0,
    "import/named": "off"
  }
}
